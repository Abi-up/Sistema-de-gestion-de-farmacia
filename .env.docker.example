# ==============================================================================
# ENTORNO DOCKER - VITALIS PHARMASYS (SISTEMA DE GESTIÓN DE FARMACIA)
# Plantilla de configuración para despliegue en contenedores Docker.
#
# Para iniciar el entorno:
#   1. Copiar este archivo a .env:
#      Linux/macOS: cp .env.docker.example .env
#      Windows:     copy .env.docker.example .env
#   2. Generar clave de aplicación:
#      docker compose exec app php artisan key:generate
# ==============================================================================

APP_NAME="Vitalis PharmaSys"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# BASE DE DATOS (Conexión dentro de la red Docker)
# NOTA: DB_HOST debe apuntar al nombre del servicio ('mariadb'), NO a 127.0.0.1
# ------------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=farmacia_laravel
DB_USERNAME=farmacia_app
DB_PASSWORD=farmacia_secret_ejemplo
DB_ROOT_PASSWORD=root_secret_ejemplo

# ------------------------------------------------------------------------------
# PUERTOS DEL HOST (Mapeo hacia el exterior)
# FORWARD_DB_PORT se mapea a 3307 para evitar colisiones con MariaDB en Windows
# ------------------------------------------------------------------------------
APP_PORT=8000
FORWARD_DB_PORT=3307
VITE_PORT=5173

# ------------------------------------------------------------------------------
# SESIONES, COLAS Y CACHÉ
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="soporte@vitalispharma.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
